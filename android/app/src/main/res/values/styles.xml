<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight: o modo escuro do celular chega até as telas (CSS prefers-color-scheme) e aos avisos. -->
    <style name="TemaMeuBolso.Base" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Mesma cor da tela de abertura: nada de piscar branco ao abrir. -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TemaMeuBolso" parent="TemaMeuBolso.Base" />

</resources>
